{
  "manifest": {
    "name": "operator",
    "private": true,
    "license": "Apache-2.0",
    "type": "module",
    "scripts": {
      "dev": "voyant develop",
      "build": "voyant build && node ../../scripts/package-operator-admin-shell.mjs",
      "measure": "node ../../scripts/measure-operator-application.mjs --require-build",
      "start": "voyant start",
      "typecheck": "pnpm run prepare:verify && NODE_OPTIONS=--max-old-space-size=6144 tsc -p .voyant/tsconfig.server.json && NODE_OPTIONS=--max-old-space-size=6144 tsc -p .voyant/tsconfig.tests-smoke.json && NODE_OPTIONS=--max-old-space-size=12288 tsc -p .voyant/tsconfig.client.json",
      "test": "pnpm run prepare:verify && vitest run --config .voyant/vitest.config.ts --passWithNoTests",
      "graph:check": "node ../../scripts/generate-operator-application-manifest.mjs --check && node ../../scripts/generate-operator-application-metadata.mjs --check && voyant db doctor --fail-on-drift",
      "prepare:verify": "node ../../scripts/generate-operator-application-manifest.mjs --check && node ../../scripts/generate-operator-application-metadata.mjs --emit && voyant build --artifacts-only && tsx .voyant/generate-routes.mjs",
      "db:migrate": "voyant migrate",
      "lint": "biome check src/ tests/"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/api-key": "1.6.23",
    "@fontsource-variable/inter-tight": "^5.2.7",
    "@hono/node-server": "^2.0.6",
    "@hono/zod-openapi": "catalog:",
    "@scalar/api-reference-react": "^0.9.51",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/core": "^3.27.1",
    "@tiptap/extensions": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@voyant-travel/framework": "workspace:^",
    "@voyant-travel/hono": "workspace:^",
    "@voyant-travel/operator-standard": "workspace:^",
    "@voyant-travel/react": "workspace:^",
    "@voyant-travel/runtime": "workspace:^",
    "better-auth": "1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "catalog:",
    "embla-carousel-react": "^8.6.0",
    "hono": "catalog:",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-phone-number-input": "^3.4.17",
    "react-resizable-panels": "^4.9.0",
    "recharts": "3.9.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.8.1",
    "@tanstack/router-generator": "1.167.18",
    "@types/node": "catalog:",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@voyant-travel/cli": "^0.40.0",
    "jsdom": "^29.1.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
