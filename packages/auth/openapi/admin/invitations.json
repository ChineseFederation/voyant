{
  "openapi": "3.1.0",
  "info": {
    "title": "Voyant Auth Invitations Admin API",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/admin/invitations": {
      "get": {
        "operationId": "listAuthInvitations",
        "x-voyant-api-id": "@voyant-travel/auth#invitations.api.admin",
        "responses": {
          "200": {
            "description": "HTTP 200"
          },
          "403": {
            "description": "HTTP 403"
          }
        },
        "summary": "List user invitations",
        "tags": ["Auth invitations"],
        "x-voyant-module": "auth",
        "x-voyant-surface": "admin"
      },
      "post": {
        "operationId": "createAuthInvitation",
        "x-voyant-api-id": "@voyant-travel/auth#invitations.api.admin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "expiresInHours": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 720
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": {}
                  }
                },
                "required": ["email"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HTTP 200"
          },
          "403": {
            "description": "HTTP 403"
          },
          "409": {
            "description": "HTTP 409"
          }
        },
        "summary": "Create a user invitation",
        "tags": ["Auth invitations"],
        "x-voyant-module": "auth",
        "x-voyant-surface": "admin"
      }
    },
    "/v1/admin/invitations/{id}": {
      "delete": {
        "operationId": "deleteAuthInvitation",
        "x-voyant-api-id": "@voyant-travel/auth#invitations.api.admin",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "HTTP 200"
          },
          "403": {
            "description": "HTTP 403"
          }
        },
        "summary": "Delete a user invitation",
        "tags": ["Auth invitations"],
        "x-voyant-module": "invitations",
        "x-voyant-surface": "admin"
      }
    }
  }
}
