{
  "openapi": "3.1.0",
  "info": {
    "title": "Voyant Event Catalog Admin API",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/admin/event-catalog": {
      "get": {
        "operationId": "getSelectedEventCatalog",
        "summary": "Get selected event contracts",
        "tags": ["Event catalog"],
        "x-voyant-api-id": "@voyant-travel/event-catalog#api.admin",
        "responses": {
          "200": {
            "description": "Versioned event contracts selected for this deployment.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "schemaVersion": {
                          "type": "string",
                          "enum": ["voyant.event-catalog.v1"]
                        },
                        "events": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "key": {
                                "type": "string"
                              },
                              "id": {
                                "type": "string"
                              },
                              "unitId": {
                                "type": "string"
                              },
                              "packageName": {
                                "type": "string"
                              },
                              "eventType": {
                                "type": "string"
                              },
                              "version": {
                                "type": "string"
                              },
                              "payloadSchema": {
                                "type": "object",
                                "additionalProperties": {}
                              },
                              "visibility": {
                                "type": "string",
                                "enum": ["internal", "external"]
                              },
                              "audit": {
                                "type": "object",
                                "properties": {
                                  "sourceModule": {
                                    "type": "string"
                                  },
                                  "category": {
                                    "type": "string",
                                    "enum": ["domain", "internal"]
                                  }
                                },
                                "required": ["sourceModule", "category"]
                              },
                              "redactedFields": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            },
                            "required": [
                              "key",
                              "id",
                              "unitId",
                              "packageName",
                              "eventType",
                              "version",
                              "payloadSchema",
                              "visibility",
                              "audit",
                              "redactedFields"
                            ]
                          }
                        }
                      },
                      "required": ["schemaVersion", "events"]
                    }
                  },
                  "required": ["data"]
                }
              }
            }
          }
        },
        "x-voyant-module": "event-catalog",
        "x-voyant-surface": "admin"
      }
    }
  }
}
