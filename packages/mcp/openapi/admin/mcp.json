{
  "openapi": "3.1.0",
  "info": {
    "title": "Voyant MCP Admin API",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/admin/mcp/manifest": {
      "get": {
        "operationId": "getMcpManifest",
        "x-voyant-api-id": "@voyant-travel/mcp#api.admin",
        "responses": {
          "200": {
            "description": "The contract-versioned tools visible to the caller."
          }
        },
        "summary": "Get the authorized MCP tool manifest",
        "tags": ["MCP"],
        "x-voyant-module": "mcp",
        "x-voyant-surface": "admin"
      }
    },
    "/v1/admin/mcp/policy": {
      "get": {
        "operationId": "getMcpExposurePolicy",
        "x-voyant-api-id": "@voyant-travel/mcp#api.admin",
        "responses": {
          "200": {
            "description": "The deployment-wide MCP exposure policy."
          }
        },
        "summary": "GET /v1/admin/mcp/policy",
        "tags": ["mcp"],
        "x-voyant-module": "mcp",
        "x-voyant-surface": "admin"
      },
      "put": {
        "operationId": "updateMcpExposurePolicy",
        "x-voyant-api-id": "@voyant-travel/mcp#api.admin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "allowedRiskLevels": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["low", "medium", "high", "critical"]
                    }
                  },
                  "allowWrites": {
                    "type": "boolean"
                  },
                  "allowSensitiveData": {
                    "type": "boolean"
                  },
                  "toolOverrides": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "enum": ["allow", "deny"]
                    }
                  }
                },
                "required": [
                  "allowedRiskLevels",
                  "allowWrites",
                  "allowSensitiveData",
                  "toolOverrides"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated deployment-wide MCP exposure policy."
          },
          "403": {
            "description": "Only an authenticated dashboard session may update the policy."
          }
        },
        "summary": "PUT /v1/admin/mcp/policy",
        "tags": ["mcp"],
        "x-voyant-module": "mcp",
        "x-voyant-surface": "admin"
      }
    },
    "/v1/admin/mcp": {
      "post": {
        "operationId": "callMcp",
        "x-voyant-api-id": "@voyant-travel/mcp#api.admin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "jsonrpc": {
                    "type": "string",
                    "enum": ["2.0"]
                  },
                  "id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "method": {
                    "type": "string"
                  },
                  "params": {
                    "type": "object",
                    "additionalProperties": {}
                  }
                },
                "required": ["jsonrpc", "method"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The MCP JSON-RPC response"
          },
          "204": {
            "description": "The MCP notification was accepted"
          }
        },
        "summary": "Send an MCP JSON-RPC request",
        "tags": ["MCP"],
        "x-voyant-module": "mcp",
        "x-voyant-surface": "admin"
      }
    }
  }
}
