{
  "name": "@voyant-travel/notifications",
  "version": "0.150.16",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./types": "./src/types.ts",
    "./template-authoring": "./src/template-authoring.ts",
    "./validation": "./src/validation.ts",
    "./routes": "./src/routes.ts",
    "./tasks": "./src/tasks/index.ts",
    "./reminder-job": "./src/reminder-job.ts",
    "./job-runtime": "./src/job-runtime.ts",
    "./runtime-port": "./src/runtime-port.ts",
    "./durable-provider-port": "./src/durable-provider-port.ts",
    "./subscriber-runtime": "./src/subscriber-runtime.ts",
    "./staff-alert-subscriber": "./src/staff-alert-subscriber.ts",
    "./tools": "./src/mcp-runtime.ts",
    "./runtime-contributor": "./src/runtime-contributor.ts",
    "./voyant": "./src/voyant.ts",
    "./emails": "./src/emails/index.ts",
    "./openapi/admin": "./openapi/admin/notifications.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "biome check src/",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepack": "pnpm run build",
    "db:generate": "drizzle-kit generate --config=drizzle.migrations.config.ts --name=notifications_baseline && node ../../scripts/migrations/guard-create-type.mjs ./migrations && node ../../scripts/migrations/ensure-extensions.mjs ./migrations"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:",
    "@react-email/components": "^0.5.7",
    "@react-email/render": "^1.4.0",
    "@voyant-travel/action-ledger": "workspace:^",
    "@voyant-travel/bookings": "workspace:^",
    "@voyant-travel/core": "workspace:^",
    "@voyant-travel/db": "workspace:^",
    "@voyant-travel/finance": "workspace:^",
    "@voyant-travel/hono": "workspace:^",
    "@voyant-travel/identity": "workspace:^",
    "@voyant-travel/legal": "workspace:^",
    "@voyant-travel/operator-settings": "workspace:^",
    "@voyant-travel/proposals": "workspace:^",
    "@voyant-travel/public-api": "workspace:^",
    "@voyant-travel/relationships": "workspace:^",
    "@voyant-travel/tools": "workspace:^",
    "@voyant-travel/types": "workspace:^",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "liquidjs": "^10.27.1",
    "react": "^19.2.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@voyant-travel/voyant-typescript-config": "workspace:^",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "openapi",
    "migrations/*.sql",
    "migrations/meta/_journal.json"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./schema": {
        "types": "./dist/schema.d.ts",
        "import": "./dist/schema.js",
        "default": "./dist/schema.js"
      },
      "./types": {
        "types": "./dist/types.d.ts",
        "import": "./dist/types.js",
        "default": "./dist/types.js"
      },
      "./template-authoring": {
        "types": "./dist/template-authoring.d.ts",
        "import": "./dist/template-authoring.js",
        "default": "./dist/template-authoring.js"
      },
      "./validation": {
        "types": "./dist/validation.d.ts",
        "import": "./dist/validation.js",
        "default": "./dist/validation.js"
      },
      "./routes": {
        "types": "./dist/routes.d.ts",
        "import": "./dist/routes.js",
        "default": "./dist/routes.js"
      },
      "./tasks": {
        "types": "./dist/tasks/index.d.ts",
        "import": "./dist/tasks/index.js",
        "default": "./dist/tasks/index.js"
      },
      "./reminder-job": {
        "types": "./dist/reminder-job.d.ts",
        "import": "./dist/reminder-job.js",
        "default": "./dist/reminder-job.js"
      },
      "./job-runtime": {
        "types": "./dist/job-runtime.d.ts",
        "import": "./dist/job-runtime.js",
        "default": "./dist/job-runtime.js"
      },
      "./runtime-port": {
        "types": "./dist/runtime-port.d.ts",
        "import": "./dist/runtime-port.js",
        "default": "./dist/runtime-port.js"
      },
      "./durable-provider-port": {
        "types": "./dist/durable-provider-port.d.ts",
        "import": "./dist/durable-provider-port.js",
        "default": "./dist/durable-provider-port.js"
      },
      "./subscriber-runtime": {
        "types": "./dist/subscriber-runtime.d.ts",
        "import": "./dist/subscriber-runtime.js",
        "default": "./dist/subscriber-runtime.js"
      },
      "./staff-alert-subscriber": {
        "types": "./dist/staff-alert-subscriber.d.ts",
        "import": "./dist/staff-alert-subscriber.js",
        "default": "./dist/staff-alert-subscriber.js"
      },
      "./tools": {
        "types": "./dist/mcp-runtime.d.ts",
        "import": "./dist/mcp-runtime.js",
        "default": "./dist/mcp-runtime.js"
      },
      "./runtime-contributor": {
        "types": "./dist/runtime-contributor.d.ts",
        "import": "./dist/runtime-contributor.js",
        "default": "./dist/runtime-contributor.js"
      },
      "./voyant": {
        "types": "./dist/voyant.d.ts",
        "import": "./dist/voyant.js",
        "default": "./dist/voyant.js"
      },
      "./emails": {
        "types": "./dist/emails/index.d.ts",
        "import": "./dist/emails/index.js",
        "default": "./dist/emails/index.js"
      },
      "./openapi/admin": "./openapi/admin/notifications.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/voyant-travel/voyant.git",
    "directory": "packages/notifications"
  },
  "voyant": {
    "schemaVersion": "voyant.package.v1",
    "kind": "module",
    "manifest": "./voyant",
    "runtime": {
      "entry": "./runtime-contributor",
      "export": "createNotificationsRuntimePortContribution"
    },
    "compatibleWith": {
      "framework": ">=0.26.0",
      "targets": [
        "node"
      ],
      "modes": [
        "local",
        "managed-cloud",
        "self-hosted"
      ]
    },
    "schema": "./schema",
    "requiresSchemas": [
      "@voyant-travel/db"
    ]
  },
  "private": true
}
