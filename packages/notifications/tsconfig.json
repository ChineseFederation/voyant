{
  "extends": "@voyant-travel/voyant-typescript-config/base.json",
  "compilerOptions": {
    "composite": false,
    "outDir": "dist",
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // The `./emails` entry point renders React Email templates server-side.
    "jsx": "react-jsx"
  },
  "include": ["src/**/*"]
}
