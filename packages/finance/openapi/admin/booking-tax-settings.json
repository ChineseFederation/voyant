{
  "openapi": "3.1.0",
  "info": {
    "title": "Booking Tax Settings API",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/admin/finance/tax-settings": {
      "get": {
        "x-voyant-api-id": "@voyant-travel/finance#booking-tax-settings-extension.api",
        "responses": {
          "200": {
            "description": "The effective booking tax settings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "taxPriceMode": {
                          "type": "string",
                          "enum": ["inclusive", "exclusive"]
                        },
                        "taxPolicyProfileId": {
                          "type": ["string", "null"]
                        },
                        "invoicingMode": {
                          "type": "string",
                          "enum": ["direct", "proforma-first"]
                        }
                      },
                      "required": ["taxPriceMode", "taxPolicyProfileId", "invoicingMode"]
                    }
                  },
                  "required": ["data"]
                }
              }
            }
          }
        },
        "operationId": "getAdminFinanceTaxSettings",
        "summary": "Get booking tax settings",
        "tags": ["finance"],
        "x-voyant-module": "finance",
        "x-voyant-surface": "admin"
      },
      "patch": {
        "x-voyant-api-id": "@voyant-travel/finance#booking-tax-settings-extension.api",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "taxPriceMode": {
                    "type": "string",
                    "enum": ["inclusive", "exclusive"]
                  },
                  "taxPolicyProfileId": {
                    "type": ["string", "null"],
                    "minLength": 1
                  },
                  "invoicingMode": {
                    "type": "string",
                    "enum": ["direct", "proforma-first"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated booking tax settings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "taxPriceMode": {
                          "type": "string",
                          "enum": ["inclusive", "exclusive"]
                        },
                        "taxPolicyProfileId": {
                          "type": ["string", "null"]
                        },
                        "invoicingMode": {
                          "type": "string",
                          "enum": ["direct", "proforma-first"]
                        }
                      },
                      "required": ["taxPriceMode", "taxPolicyProfileId", "invoicingMode"]
                    }
                  },
                  "required": ["data"]
                }
              }
            }
          },
          "409": {
            "description": "This deployment does not support tax setting updates"
          }
        },
        "operationId": "patchAdminFinanceTaxSettings",
        "summary": "Update booking tax settings",
        "tags": ["finance"],
        "x-voyant-module": "finance",
        "x-voyant-surface": "admin"
      }
    }
  },
  "components": {
    "schemas": {
      "BookingTaxSettings": {
        "type": "object",
        "required": ["taxPriceMode", "taxPolicyProfileId", "invoicingMode"],
        "properties": {
          "taxPriceMode": {
            "type": "string",
            "enum": ["inclusive", "exclusive"]
          },
          "taxPolicyProfileId": {
            "type": ["string", "null"]
          },
          "invoicingMode": {
            "type": "string",
            "enum": ["direct", "proforma-first"]
          }
        }
      }
    }
  }
}
