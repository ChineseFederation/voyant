{
  "name": "@voyant-travel/public-api-client",
  "version": "0.296.0",
  "description": "Typed client for the Voyant Public API. Generated from the published OpenAPI surface; a publishable key cannot see secret-only operations.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/voyant-travel/voyant.git",
    "directory": "packages/public-api-client"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./src/generated/index.ts",
    "./typed-client": "./src/typed-client.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "biome check src/",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@voyant-travel/voyant-typescript-config": "workspace:^",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./generated": {
        "types": "./dist/generated/index.d.ts",
        "import": "./dist/generated/index.js",
        "default": "./dist/generated/index.js"
      },
      "./typed-client": {
        "types": "./dist/typed-client.d.ts",
        "import": "./dist/typed-client.js",
        "default": "./dist/typed-client.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "dependencies": {
    "@voyant-travel/graph-contracts": "workspace:^",
    "openapi-fetch": "catalog:"
  }
}
