{
  "name": "@voyant-travel/identity",
  "version": "0.237.2",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./service": "./src/service.ts",
    "./schema": "./src/schema.ts",
    "./validation": "./src/validation.ts",
    "./tools": "./src/mcp-runtime.ts",
    "./routes": "./src/routes.ts",
    "./voyant": "./src/voyant.ts",
    "./openapi/admin": "./openapi/admin/identity.json",
    "./verification": "./src/verification/index.ts",
    "./verification/schema": "./src/verification/schema.ts",
    "./verification/public-routes": "./src/verification/routes-public.ts",
    "./verification/service": "./src/verification/service.ts",
    "./verification/validation": "./src/verification/validation.ts",
    "./runtime-port": "./src/runtime-port.ts",
    "./openapi/verification": "./openapi/public-api/identity-verification.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "db:generate": "drizzle-kit generate --config=drizzle.migrations.config.ts --name=identity_baseline && node ../../scripts/migrations/guard-create-type.mjs ./migrations && node ../../scripts/migrations/ensure-extensions.mjs ./migrations",
    "generate:openapi": "node --import tsx scripts/generate-openapi.ts && node --import tsx scripts/generate-verification-openapi.ts && biome format --write openapi/admin/identity.json openapi/public-api/identity-verification.json",
    "lint": "biome check src/",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:",
    "@voyant-travel/action-ledger": "workspace:^",
    "@voyant-travel/core": "workspace:^",
    "@voyant-travel/db": "workspace:^",
    "@voyant-travel/types": "workspace:^",
    "@voyant-travel/identity-contracts": "workspace:^",
    "@voyant-travel/tools": "workspace:^",
    "@voyant-travel/hono": "workspace:^",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@voyant-travel/voyant-typescript-config": "workspace:^",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  },
  "files": [
    "dist",
    "openapi",
    "migrations/*.sql",
    "migrations/meta/_journal.json"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./service": {
        "types": "./dist/service.d.ts",
        "import": "./dist/service.js",
        "default": "./dist/service.js"
      },
      "./schema": {
        "types": "./dist/schema.d.ts",
        "import": "./dist/schema.js",
        "default": "./dist/schema.js"
      },
      "./validation": {
        "types": "./dist/validation.d.ts",
        "import": "./dist/validation.js",
        "default": "./dist/validation.js"
      },
      "./tools": {
        "types": "./dist/mcp-runtime.d.ts",
        "import": "./dist/mcp-runtime.js",
        "default": "./dist/mcp-runtime.js"
      },
      "./routes": {
        "types": "./dist/routes.d.ts",
        "import": "./dist/routes.js",
        "default": "./dist/routes.js"
      },
      "./voyant": {
        "types": "./dist/voyant.d.ts",
        "import": "./dist/voyant.js",
        "default": "./dist/voyant.js"
      },
      "./openapi/admin": "./openapi/admin/identity.json",
      "./verification": {
        "types": "./dist/verification/index.d.ts",
        "import": "./dist/verification/index.js",
        "default": "./dist/verification/index.js"
      },
      "./verification/schema": {
        "types": "./dist/verification/schema.d.ts",
        "import": "./dist/verification/schema.js",
        "default": "./dist/verification/schema.js"
      },
      "./verification/public-routes": {
        "types": "./dist/verification/routes-public.d.ts",
        "import": "./dist/verification/routes-public.js",
        "default": "./dist/verification/routes-public.js"
      },
      "./verification/service": {
        "types": "./dist/verification/service.d.ts",
        "import": "./dist/verification/service.js",
        "default": "./dist/verification/service.js"
      },
      "./verification/validation": {
        "types": "./dist/verification/validation.d.ts",
        "import": "./dist/verification/validation.js",
        "default": "./dist/verification/validation.js"
      },
      "./runtime-port": {
        "types": "./dist/runtime-port.d.ts",
        "import": "./dist/runtime-port.js",
        "default": "./dist/runtime-port.js"
      },
      "./openapi/verification": "./openapi/public-api/identity-verification.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/voyant-travel/voyant.git",
    "directory": "packages/identity"
  },
  "voyant": {
    "schemaVersion": "voyant.package.v1",
    "kind": "module",
    "manifest": "./voyant",
    "compatibleWith": {
      "framework": ">=0.26.0",
      "targets": [
        "node"
      ],
      "modes": [
        "local",
        "managed-cloud",
        "self-hosted"
      ]
    },
    "schema": "./schema",
    "requiresSchemas": [
      "@voyant-travel/db"
    ],
    "legacyMigrationSources": [
      "public-api",
      "storefront"
    ]
  },
  "private": true
}
